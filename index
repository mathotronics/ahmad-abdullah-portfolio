<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <!-- =========================
       PAGE TITLE / SEO
       ========================= -->
  <title>Ahmad Abdullah | Robotics, STEM & Fabrication Instructor</title>
  <meta name="description" content="Portfolio of Ahmad Abdullah, Robotics, STEM and Fabrication Instructor specializing in Arduino, electronics, robotics, CNC, laser fabrication, CAD, digital fabrication and hands-on technical education.">

  <style>
    :root{
      --navy:#0f2742;
      --blue:#123b63;
      --teal:#10a6a6;
      --teal-light:#e7f7f7;
      --light:#f5f8fb;
      --white:#ffffff;
      --gray:#5f6f7f;
      --dark:#1d2935;
      --line:#d9e4ec;
      --shadow:0 18px 45px rgba(15,39,66,.12);
      --radius:22px;
    }

    *{box-sizing:border-box;margin:0;padding:0}
    html{scroll-behavior:smooth}
    body{
      font-family:Arial,Helvetica,sans-serif;
      line-height:1.6;
      color:var(--dark);
      background:var(--light);
    }
    a{color:inherit;text-decoration:none}
    img{max-width:100%;display:block}

    .container{width:min(1120px,92%);margin:auto}

    /* =========================
       NAVIGATION
       ========================= */
    header{
      background:rgba(255,255,255,.95);
      backdrop-filter:blur(12px);
      border-bottom:1px solid var(--line);
      position:sticky;
      top:0;
      z-index:50;
    }
    .nav{
      min-height:74px;
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:20px;
    }
    .brand{
      font-weight:800;
      font-size:1.05rem;
      color:var(--navy);
    }
    .brand span{color:var(--teal)}
    nav{
      display:flex;
      align-items:center;
      gap:22px;
      font-size:.94rem;
      color:var(--gray);
    }
    nav a:hover{color:var(--teal)}

    .mobile-menu-btn{
      display:none;
      background:none;
      border:0;
      color:var(--navy);
      font-size:1.85rem;
      line-height:1;
      cursor:pointer;
      padding:8px 4px;
      font-family:Arial,Helvetica,sans-serif;
    }
    .mobile-menu-btn:focus-visible{
      outline:2px solid var(--teal);
      outline-offset:4px;
      border-radius:6px;
    }

    /* =========================
       HERO
       ========================= */
    .hero{
      position:relative;
      overflow:hidden;
      padding:86px 0 72px;
      background:
        radial-gradient(circle at top right,rgba(16,166,166,.20),transparent 35%),
        linear-gradient(135deg,var(--navy),var(--blue));
      color:white;
    }
    .hero-grid{
      position:relative;
      z-index:1;
      display:grid;
      grid-template-columns:1.15fr .85fr;
      gap:46px;
      align-items:center;
    }
    .eyebrow{
      display:inline-flex;
      background:rgba(255,255,255,.12);
      border:1px solid rgba(255,255,255,.18);
      padding:8px 14px;
      border-radius:999px;
      font-size:.9rem;
      margin-bottom:22px;
    }
    h1{
      font-size:clamp(2.6rem,6vw,5rem);
      line-height:1.02;
      margin-bottom:20px;
      letter-spacing:-1.5px;
    }
    .hero h2{
      font-size:clamp(1.15rem,2vw,1.6rem);
      font-weight:500;
      color:#d7f5f4;
      margin-bottom:22px;
    }
    .hero p{
      font-size:1.08rem;
      color:#eaf3f8;
      max-width:700px;
    }
    .hero-actions{
      display:flex;
      flex-wrap:wrap;
      gap:14px;
      margin-top:32px;
    }
    .btn{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      min-height:46px;
      padding:0 20px;
      border-radius:999px;
      font-weight:700;
    }
    .btn-primary{background:var(--teal);color:white}
    .btn-secondary{
      background:rgba(255,255,255,.12);
      color:white;
      border:1px solid rgba(255,255,255,.25);
    }
    .hero-photo-card{
      background:rgba(255,255,255,.11);
      border:1px solid rgba(255,255,255,.18);
      border-radius:30px;
      padding:14px;
      box-shadow:0 20px 40px rgba(0,0,0,.13);
    }
    .hero-photo-card img{
      width:100%;
      aspect-ratio:1/1;
      object-fit:contain;
      object-position:center;
      border-radius:22px;
      background:rgba(255,255,255,.06);
    }

    /* =========================
       GENERAL SECTIONS
       ========================= */
    section{padding:74px 0}
    .section-heading{
      display:flex;
      justify-content:space-between;
      gap:24px;
      align-items:end;
      margin-bottom:34px;
    }
    .section-heading h2{
      color:var(--navy);
      font-size:clamp(1.9rem,4vw,2.7rem);
      line-height:1.12;
    }
    .section-heading p{
      color:var(--gray);
      max-width:560px;
    }

    /* =========================
       ABOUT
       ========================= */
    .about-grid{
      display:grid;
      grid-template-columns:.85fr 1.15fr;
      gap:28px;
    }
    .profile-box{
      background:var(--navy);
      color:white;
      border-radius:var(--radius);
      padding:30px;
      box-shadow:var(--shadow);
    }
    .profile-box h3{
      font-size:1.45rem;
      margin-bottom:10px;
    }
    .profile-box p{color:#dcebf4}
    .profile-tags{
      display:flex;
      flex-wrap:wrap;
      gap:8px;
      margin-top:18px;
    }
    .profile-tag{
      background:rgba(255,255,255,.12);
      border:1px solid rgba(255,255,255,.18);
      border-radius:999px;
      padding:6px 10px;
      font-size:.85rem;
    }
    .about-text{
      background:white;
      border:1px solid var(--line);
      border-radius:var(--radius);
      padding:30px;
      box-shadow:var(--shadow);
    }
    .about-text p+p{margin-top:16px}

    /* =========================
       EXPERTISE
       ========================= */
    .cards{
      display:grid;
      grid-template-columns:repeat(3,1fr);
      gap:22px;
    }
    .skill-card-image{
      width:100%;
      height:150px;
      object-fit:contain;
      background:#f3f5f7;
      border-radius:14px;
      margin-bottom:18px;
      display:block;
    }
    .card{
      background:white;
      border:1px solid var(--line);
      border-radius:var(--radius);
      padding:26px;
      box-shadow:var(--shadow);
    }
    .icon{
      width:46px;height:46px;
      border-radius:14px;
      display:grid;
      place-items:center;
      background:var(--teal-light);
      color:var(--teal);
      font-size:1.35rem;
      margin-bottom:18px;
    }
    .card h3{color:var(--navy);margin-bottom:10px}
    .card p{color:var(--gray);font-size:.98rem}

    /* =========================
       PROJECTS
       ========================= */
    .project-grid{
      display:grid;
      grid-template-columns:repeat(3,1fr);
      gap:22px;
    }
    .project-card{
      background:white;
      border:1px solid var(--line);
      border-radius:var(--radius);
      overflow:hidden;
      box-shadow:var(--shadow);
    }
    .project-image{
      position:relative;
      display:flex;
      align-items:center;
      justify-content:center;
      background:#eaf1f5;
      aspect-ratio:4/3;
      overflow:hidden;
    }
    .project-image img{
      width:100%;
      height:100%;
      object-fit:contain;
      object-position:center;
    }
    .placeholder{
      height:100%;
      display:flex;
      align-items:center;
      justify-content:center;
      text-align:center;
      padding:25px;
      color:var(--gray);
      font-size:.9rem;
    }
    .placeholder strong{
      display:block;
      color:var(--navy);
      font-size:1rem;
      margin-bottom:6px;
    }
    .project-body{padding:22px}
    .project-body h3{
      color:var(--navy);
      font-size:1.18rem;
      margin-bottom:9px;
    }
    .project-body p{
      color:var(--gray);
      margin-bottom:16px;
      font-size:.95rem;
    }
    .tags{
      display:flex;
      flex-wrap:wrap;
      gap:8px;
    }
    .tag{
      background:#eef5f8;
      color:var(--blue);
      padding:6px 10px;
      border-radius:999px;
      font-size:.82rem;
      font-weight:700;
    }

    /* =========================
       RESOURCES
       ========================= */
    .resource-grid{
      display:grid;
      grid-template-columns:repeat(3,1fr);
      gap:22px;
    }
    .resource-card{
      background:white;
      border:1px solid var(--line);
      border-radius:var(--radius);
      overflow:hidden;
      box-shadow:var(--shadow);
    }
    .resource-thumb{
      background:#eef5f8;
      padding:12px;
    }
    .resource-thumb img{
      width:100%;
      aspect-ratio:3/4;
      object-fit:contain;
      object-position:center;
      border-radius:15px;
      background:white;
    }
    .resource-body{padding:22px}
    .resource-body h3{
      color:var(--navy);
      font-size:1.14rem;
      margin-bottom:4px;
    }
    .resource-subtitle{
      color:var(--teal);
      font-weight:800;
      font-size:.92rem;
      margin-bottom:12px;
    }
    .resource-body p{
      color:var(--gray);
      font-size:.95rem;
    }

    .resource-actions{
      margin-top:18px;
    }
    .btn-resource{
      background:var(--navy);
      color:white;
      min-height:42px;
      padding:0 16px;
      font-size:.9rem;
    }
    .btn-resource:hover{
      background:var(--teal);
    }
    .resource-note{
      margin-top:28px;
      background:var(--teal-light);
      border:1px solid #c9eeee;
      border-radius:18px;
      padding:20px 22px;
      color:var(--gray);
    }
    .resource-note strong{color:var(--navy)}
    .resource-store-action{
      margin-top:22px;
      text-align:center;
    }
    /* =========================
       CONTACT
       ========================= */
    .contact-grid{
      display:grid;
      grid-template-columns:repeat(3,1fr);
      gap:18px;
    }
    .contact-item{
      background:white;
      border:1px solid var(--line);
      border-radius:18px;
      padding:22px;
      box-shadow:var(--shadow);
    }
    .contact-item small{
      color:var(--gray);
      display:block;
      margin-bottom:6px;
    }
    .contact-item strong{color:var(--navy)}

    footer{
      background:var(--navy);
      color:#dcebf4;
      padding:30px 0;
      text-align:center;
      font-size:.92rem;
    }

    @media(max-width:980px){
      .mobile-menu-btn{display:block}

      nav{
        display:none;
        position:absolute;
        top:74px;
        left:0;
        width:100%;
        background:rgba(255,255,255,.98);
        backdrop-filter:blur(12px);
        border-bottom:1px solid var(--line);
        box-shadow:0 14px 30px rgba(15,39,66,.12);
        flex-direction:column;
        align-items:stretch;
        gap:0;
      }

      nav.active{display:flex}

      nav a{
        display:block;
        padding:15px 4%;
        border-bottom:1px solid var(--line);
        font-size:1rem;
      }

      nav a:last-child{border-bottom:0}

      .hero-grid,.about-grid{grid-template-columns:1fr}
      .cards,.project-grid,.resource-grid,.contact-grid{grid-template-columns:1fr}
      .section-heading{display:block}
      .section-heading p{margin-top:12px}
    }
  </style>
</head>

<body>

<header>
  <div class="container nav">
    <a class="brand" href="#top">Ahmad <span>Abdullah</span></a>
    <nav id="mainNav">
      <a href="#about">About</a>
